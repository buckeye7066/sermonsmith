# API base URL used by the React web app.
#
# Local development uses Vite's configurable same-origin /api proxy. Keep this
# empty so SERMONSMITH_DEV_API_URL (or the default) controls the proxy target.
VITE_API_URL=

# Production example (Railway-hosted API + Vercel-hosted web):
# VITE_API_URL=https://your-api.up.railway.app

# Same-origin proxy setup (custom domain in front of both web + API):
# leave VITE_API_URL empty — the apiClient falls back to window.location.origin
# automatically.
# VITE_API_URL=
