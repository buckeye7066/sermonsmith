import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

Deno.serve(async (req) => {
  const base44 = createClientFromRequest(req);
  
  try {
    const user = await base44.auth.me();
    if (!user) {
      return Response.json({ error: 'Unauthorized' }, { status: 401 });
    }

    console.log('🧪 TEST IMPORT: Starting test import of Genesis 1...');

    // Test 1: Can we write to Verse entity?
    const testVerse = {
      translation_id: 'KJV',
      book_name: 'Genesis',
      chapter: 1,
      verse: 1,
      text: 'In the beginning God created the heaven and the earth.',
      source_hash: 'TEST-KJV-Genesis-1-1'
    };

    console.log('🧪 TEST IMPORT: Attempting to write test verse...');
    
    try {
      await base44.asServiceRole.entities.Verse.create(testVerse);
      console.log('✅ TEST IMPORT: Successfully wrote test verse!');
    } catch (e) {
      console.error('❌ TEST IMPORT: Failed to write test verse:', e.message);
      return Response.json({
        success: false,
        error: 'Failed to write to database',
        details: e.message
      });
    }

    // Test 2: Can we read it back?
    console.log('🧪 TEST IMPORT: Attempting to read test verse...');
    
    try {
      const verses = await base44.asServiceRole.entities.Verse.filter({
        translation_id: 'KJV',
        book_name: 'Genesis',
        chapter: 1
      });
      
      console.log(`✅ TEST IMPORT: Found ${verses.length} verses in Genesis 1`);
      
      return Response.json({
        success: true,
        message: 'Test import successful!',
        versesFound: verses.length,
        testVerseCreated: true,
        sample: verses.slice(0, 3)
      });
    } catch (e) {
      console.error('❌ TEST IMPORT: Failed to read verses:', e.message);
      return Response.json({
        success: false,
        error: 'Failed to read from database',
        details: e.message
      });
    }

  } catch (error) {
    console.error('❌ TEST IMPORT: Fatal error:', error);
    return Response.json({ 
      success: false,
      error: error.message 
    }, { status: 500 });
  }
});