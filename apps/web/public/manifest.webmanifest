{
  "name": "SermonSmith - AI-Assisted Sermon & Bible Study Drafts",
  "short_name": "SermonSmith",
  "description": "Create editable sermon and Bible-study drafts, then verify Scripture references and theological claims before teaching.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "categories": ["education", "productivity", "lifestyle"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icon.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Bible Reader",
      "short_name": "Read Bible",
      "description": "Open Bible Reader",
      "url": "/Reader?source=shortcut",
      "icons": [{ "src": "/icon.png", "sizes": "1024x1024", "type": "image/png" }]
    },
    {
      "name": "Sermon Builder",
      "short_name": "New Sermon",
      "description": "Create a new sermon draft",
      "url": "/SermonBuilder?source=shortcut",
      "icons": [{ "src": "/icon.png", "sizes": "1024x1024", "type": "image/png" }]
    },
    {
      "name": "Bible Study",
      "short_name": "Study",
      "description": "Create a Bible study draft",
      "url": "/BibleStudy?source=shortcut",
      "icons": [{ "src": "/icon.png", "sizes": "1024x1024", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/Reader?share=true",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    { "protocol": "web+bible", "url": "/Reader?verse=%s" }
  ]
}
