# ─── Required in production (loadEnv() refuses to start without these) ───────
DATABASE_URL="postgresql://user:password@localhost:5432/sermonsmith"

# JWT_SECRET MUST be at least 32 chars of random data in production.
# Generate: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"

# REQUIRED in production. >= 32 chars of random data.
# Generate: openssl rand -base64 48
COOKIE_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"

# Comma-separated allowlist of front-end origins for CORS + CSRF.
CORS_ORIGIN="http://localhost:5173,https://sermonsmith.app"

# Front-end base URL used in email links and Stripe redirects.
FRONTEND_URL="http://localhost:5173"

# ─── Cookie behaviour for cross-domain auth ─────────────────────────────────
# When the web app and the API live on different eTLD+1 (e.g. Vercel + Railway)
# the auth cookie MUST be SameSite=None + Secure or browsers will silently drop
# it on cross-site fetches. cookieOptions() defaults to "none" in production;
# set to "lax" if you deploy api and web on the same registered domain.
# COOKIE_SAMESITE="none"
#
# Optional registered domain to scope the cookie to (e.g. ".sermonsmith.app")
# so api.sermonsmith.app and app.sermonsmith.app can share auth.
# COOKIE_DOMAIN=".sermonsmith.app"

# ─── OpenAI (AI features) ────────────────────────────────────────────────────
# Required in production unless DISABLE_AI=1.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="30000"
# Image-generation model for Bible Maps visual aids. Defaults to "gpt-image-1"
# and auto-falls-back across the account's available image models, so this is
# usually unnecessary. Set it to pin a specific model (e.g. "dall-e-3",
# "gpt-image-1.5") your OpenAI account has access to.
# OPENAI_IMAGE_MODEL="gpt-image-1"

# ─── Developer tools (security) ──────────────────────────────────────────────
# The Function Reviewer admin page exposes backend source/metadata and can sync
# code to GitHub. It is admin-gated, but for defense-in-depth its endpoints are
# DISABLED in production unless this is set to "true". Non-production envs have
# it on by default. Set "false" to force-disable everywhere.
# ENABLE_DEV_TOOLS="true"

# ─── Premium Bible translations (optional) ───────────────────────────────────
# The premium tier works out of the box with NO key, serving getBible.net's
# ~70 translations across ~50 languages (gated to premium accounts). To unlock
# the full "1000+ translations in 200+ languages" catalogue, get a free key
# from https://scripture.api.bible and set it here:
# API_BIBLE_KEY="your-api-bible-key"
# Turn the premium translation tier off entirely (free 8 bibles only):
# DISABLE_PREMIUM_TRANSLATIONS="1"
# PREMIUM_TRANSLATIONS_TTL_MS="21600000"   # catalogue cache TTL (default 6h)

# ─── Stripe (billing) ────────────────────────────────────────────────────────
# Required in production unless DISABLE_BILLING=1.
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_ID="price_your_price_id"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Required in production unless DISABLE_PASSWORD_RESET=1.
RESEND_API_KEY="re_your_resend_key"
EMAIL_FROM="SermonSmith <noreply@sermonsmith.app>"

# Optional: scripture.api.bible key for the Scripture API import path.
SCRIPTURE_API_KEY=""

# ─── Misc ────────────────────────────────────────────────────────────────────
ADMIN_EMAILS="ops@example.com"
NODE_ENV="development"
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# ─── Feature flags — uncomment in deployments that intentionally disable a
# feature so loadEnv() does not require its keys.
# DISABLE_AI="1"
# DISABLE_BILLING="1"
# DISABLE_PASSWORD_RESET="1"
