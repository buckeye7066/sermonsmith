# ─── Required in production (loadEnv() refuses to start without these) ───────
DATABASE_URL="postgresql://user:password@localhost:5432/sermonsmith"

# JWT_SECRET MUST be at least 32 chars of random data in production.
# Generate: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"

# Optional but recommended; if set must also be >= 32 chars.
COOKIE_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"

# Comma-separated allowlist of front-end origins for CORS + CSRF.
CORS_ORIGIN="http://localhost:5173,https://sermonsmith.app"

# Front-end base URL used in email links and Stripe redirects.
FRONTEND_URL="http://localhost:5173"

# ─── OpenAI (AI features) ────────────────────────────────────────────────────
# Required in production unless DISABLE_AI=1.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="30000"

# ─── Stripe (billing) ────────────────────────────────────────────────────────
# Required in production unless DISABLE_BILLING=1.
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_ID="price_your_price_id"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Required in production unless DISABLE_PASSWORD_RESET=1.
RESEND_API_KEY="re_your_resend_key"
EMAIL_FROM="SermonSmith <noreply@sermonsmith.app>"

# Optional: scripture.api.bible key for the Scripture API import path.
SCRIPTURE_API_KEY=""

# ─── Misc ────────────────────────────────────────────────────────────────────
ADMIN_EMAILS="ops@example.com"
NODE_ENV="development"
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# ─── Feature flags — uncomment in deployments that intentionally disable a
# feature so loadEnv() does not require its keys.
# DISABLE_AI="1"
# DISABLE_BILLING="1"
# DISABLE_PASSWORD_RESET="1"
