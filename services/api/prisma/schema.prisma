generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String
  // Admin-verified copy of an allowlisted promotional email. Registration
  // never populates this field, so an unverified mailbox claim cannot grant
  // permanent Premium access. Existing approved accounts are backfilled by an
  // explicit migration and future changes go through the admin user route.
  promotionalEmail     String?  @map("promotional_email")
  // Admin-controlled phone identifier used only for the owner's legacy
  // promotional allowlist. The self-service profile `phone` field is not an
  // authorization source; keeping this value on the User row prevents a user
  // from granting themselves Premium by editing profile JSON.
  promotionalPhone     String?  @map("promotional_phone")
  name                 String?
  full_name            String?
  avatar               String?
  role                 String   @default("user")
  premium              Boolean  @default(false)
  // Free-trial / comp window (GrantFlow-style "free week / free month"). When
  // set to a future timestamp the account is effectively premium until then;
  // we deliberately set ONLY this (not `premium`) for grants so access expires
  // automatically at the date with no scheduler. Paid Stripe subs use `premium`
  // and leave this null.
  premium_until        DateTime?
  // tokenVersion is bumped on password change / reset so any previously
  // issued JWT for this user instantly becomes invalid. Without this,
  // a leaked 30-day cookie remained valid until expiry even after the
  // legitimate owner rotated their password.
  tokenVersion         Int      @default(0) @map("token_version")
  profile              Json     @default("{}")
  onboarding_completed Boolean  @default(false)
  special_message      String?
  last_seen_version    String?
  // Stripe customer id, captured on the first completed checkout. Lets the
  // subscription-cancelled webhook downgrade the exact account instead of
  // matching by email (which breaks if the user later changes their email).
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  // Soft delete: account deletion sets this (and bumps tokenVersion) instead of
  // hard-deleting the row and cascade-wiping the user's sermons/studies. Auth
  // and login reject users with deleted_at set; data is recoverable / auditable.
  deletedAt            DateTime? @map("deleted_at")
  // Admin ban. The dedicated auth route updates these fields, revokes sessions,
  // and performs locked community succession/cleanup atomically. Generic User
  // updates deliberately strip them. Login and token validation reject banned
  // accounts.
  is_banned            Boolean  @default(false)
  banned_at            DateTime?
  // Stamped on every successful sign-in (login or registration auto-login).
  // NULL means the user has never signed in — the transition NULL→set is what
  // fires the one-time "new user first login" owner notification. The
  // migration backfills existing users so they never read as "new".
  lastLoginAt          DateTime? @map("last_login_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  entities       Entity[]
  passwordResets PasswordReset[]
  sermons        Sermon[]
  sermonSeries   SermonSeries[]
  sermonOutlines SermonOutline[]
  bibleStudies   BibleStudy[]
  studyNotes     StudyNote[]
  highlights     Highlight[]
  bookmarks      Bookmark[]
  prayerRequests PrayerRequest[]
  sharedContents SharedContent[]
  forumPosts     ForumPost[]
  studyGroups    StudyGroup[]
  auditLogs      AuditLog[]
  communityLikes CommunityLike[]
  savedContents  SavedContent[]
  following      CommunityFollow[] @relation("CommunityFollower")
  followers      CommunityFollow[] @relation("CommunityFollowing")
  communityGroupMemberships CommunityGroupMember[]
  aiAuditLogs    AiAuditLog[]

  @@map("users")
}

model Entity {
  id        String   @id @default(uuid())
  type      String
  data      Json     @default("{}")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, userId])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("entities")
}

model Sermon {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  status        String   @default("draft")
  topic         String?
  anchorPassage String?  @map("anchor_passage")
  searchText    String?  @map("search_text")
  content       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("sermons")
}

model SermonSeries {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  status      String   @default("draft")
  searchText  String?  @map("search_text")
  content     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("sermon_series")
}

model SermonOutline {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("draft")
  content   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("sermon_outlines")
}

model BibleStudy {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  passage    String?
  status     String   @default("draft")
  searchText String?  @map("search_text")
  content    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("bible_studies")
}

model StudyNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  passage   String?
  visibility String @default("private")
  searchText String? @map("search_text")
  content   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([visibility])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("study_notes")
}

model Highlight {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage   String?
  color     String?
  content   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([passage])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("highlights")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage   String?
  label     String?
  content   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([passage])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("bookmarks")
}

model PrayerRequest {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  status     String   @default("active")
  visibility String   @default("private")
  content    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("prayer_requests")
}

model SharedContent {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  contentType    String   @map("content_type")
  visibility     String   @default("private")
  status         String   @default("active")
  reportedCount  Int      @default(0) @map("reported_count")
  moderatorNotes String?  @map("moderator_notes")
  removedAt      DateTime? @map("removed_at")
  removedBy      String?  @map("removed_by")
  content        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([visibility])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("shared_content")
}

model ForumPost {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  status         String   @default("active")
  visibility     String   @default("public")
  reportedCount  Int      @default(0) @map("reported_count")
  moderatorNotes String?  @map("moderator_notes")
  removedAt      DateTime? @map("removed_at")
  removedBy      String?  @map("removed_by")
  content        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([visibility])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("forum_posts")
}

model StudyGroup {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  visibility String   @default("group")
  status     String   @default("active")
  content    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([visibility])
  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("study_groups")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  metadata   Json    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CommunityLike {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String   @map("content_id")
  contentType String @map("content_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, contentId, contentType])
  @@index([contentId, contentType])
  @@map("community_likes")
}

model SavedContent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String   @map("content_id")
  contentType String @map("content_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, contentId, contentType])
  @@index([contentId, contentType])
  @@map("saved_content")
}

model CommunityFollow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("CommunityFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("CommunityFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("community_follows")
}

// Membership is relational rather than embedded only in Entity.data so the
// database can enforce one membership per user/group. Group content itself
// remains in the legacy Entity store while the community surface migrates.
model CommunityGroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  userName String   @map("user_name")
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("community_group_members")
}

// Single-use, hashed-at-rest password reset tokens. The plaintext token is
// emailed to the user; only the SHA-256 hash hits Postgres so a database
// leak does not let an attacker reset accounts.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

// Idempotency record for Stripe webhook deliveries. Inserted ONLY after
// the event handler has successfully applied its side effect. A duplicate
// delivery is short-circuited with `{ received: true, duplicate: true }`.
model StripeEvent {
  id              String   @id @default(uuid())
  stripeEventId   String   @unique @map("stripe_event_id")
  type            String
  processedAt     DateTime @default(now()) @map("processed_at")

  @@index([type])
  @@map("stripe_events")
}

// Per-user, per-day AI usage counter. Replaces the previous in-memory
// Map-based counter so that limits survive process restarts and apply
// across multiple API replicas.
//
// `bucket` is a UTC date in YYYY-MM-DD for text generation and a namespaced
// value such as media:YYYY-MM-DD for other metered providers. The
// (userId, bucket) compound uniqueness lets each counter upsert atomically.
model AiUsage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bucket    String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, bucket])
  @@index([userId])
  @@map("ai_usage")
}

model AiAuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String
  model        String?
  promptHash   String?  @map("prompt_hash")
  responseHash String?  @map("response_hash")
  tokenEstimate Int?    @map("token_estimate")
  durationMs   Int?     @map("duration_ms")
  status       String
  failureType  String?  @map("failure_type")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([feature])
  @@index([status])
  @@index([createdAt])
  @@map("ai_audit_logs")
}

// Agent-mesh communication: operational notes one assistant persona leaves for
// another (or broadcasts). `toAgent` is a registered agent id from
// @sermonsmith/shared/agents, or the literal 'broadcast'. `readBy` is a JSON
// map of agentId -> ISO timestamp recording which agents have consumed the
// message. PRIVACY: `body` and `metadata` carry ONLY operational metadata
// (feature ids, failure types, model names, counts) — never user prompts or
// generated content; the service layer (agentMesh.js) enforces this by
// composing bodies itself and capping length. Retention is bounded on write
// (30 days / newest 200 rows).
model AgentMessage {
  id        String   @id @default(uuid())
  fromAgent String   @map("from_agent")
  toAgent   String   @map("to_agent")
  kind      String
  body      String
  metadata  Json?
  readBy    Json     @default("{}") @map("read_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([toAgent, createdAt])
  @@map("agent_messages")
}

// Agent-mesh learning: a deduplicated operational lesson an agent has derived
// from its own telemetry (e.g. "model X failing repeatedly"). The compound
// unique (authorAgent, topic, claim) makes recordAgentLesson an upsert: a
// repeat observation refreshes updatedAt/evidence and bumps timesSeen instead
// of duplicating rows. `consumedBy` maps agentId -> ISO timestamp of when a
// peer agent had the lesson injected into one of its runs (the visible
// cross-agent teaching). Same privacy rule as agent_messages: operational
// metadata only, never user content.
model AgentLesson {
  id            String   @id @default(uuid())
  authorAgent   String   @map("author_agent")
  topic         String
  claim         String
  evidence      Json?
  timesSeen     Int      @default(1) @map("times_seen")
  confirmations Json     @default("[]")
  refutations   Json     @default("[]")
  consumedBy    Json     @default("{}") @map("consumed_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([authorAgent, topic, claim])
  @@index([topic, updatedAt])
  @@map("agent_lessons")
}

model BibleTranslation {
  id              String   @id
  name            String
  sourceUrl       String?  @map("source_url")
  license         String?
  attribution     String?
  copyrightNotice String?  @map("copyright_notice")
  publicDomain    Boolean  @default(false) @map("public_domain")
  displayAllowed  Boolean  @default(true) @map("display_allowed")
  exportAllowed   Boolean  @default(false) @map("export_allowed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("bible_translations")
}

model BiblePassageCache {
  id            String   @id @default(uuid())
  translationId String   @map("translation_id")
  reference     String
  normalizedRef String   @map("normalized_ref")
  payload       Json
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([translationId, normalizedRef])
  @@index([translationId])
  @@index([reference])
  @@map("bible_passage_cache")
}

model BibleChapterCache {
  id          String   @id @default(uuid())
  translation String
  book        String
  chapter     Int
  payload     Json
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([translation, book, chapter])
  @@index([translation, book])
  @@map("bible_chapter_cache")
}
