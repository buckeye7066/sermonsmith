generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String
  name                 String?
  full_name            String?
  avatar               String?
  role                 String   @default("user")
  premium              Boolean  @default(false)
  // tokenVersion is bumped on password change / reset so any previously
  // issued JWT for this user instantly becomes invalid. Without this,
  // a leaked 30-day cookie remained valid until expiry even after the
  // legitimate owner rotated their password.
  tokenVersion         Int      @default(0) @map("token_version")
  profile              Json     @default("{}")
  onboarding_completed Boolean  @default(false)
  special_message      String?
  last_seen_version    String?
  // Stripe customer id, captured on the first completed checkout. Lets the
  // subscription-cancelled webhook downgrade the exact account instead of
  // matching by email (which breaks if the user later changes their email).
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  // Soft delete: account deletion sets this (and bumps tokenVersion) instead of
  // hard-deleting the row and cascade-wiping the user's sermons/studies. Auth
  // and login reject users with deleted_at set; data is recoverable / auditable.
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  entities       Entity[]
  passwordResets PasswordReset[]

  @@map("users")
}

model Entity {
  id        String   @id @default(uuid())
  type      String
  data      Json     @default("{}")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, userId])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("entities")
}

// Single-use, hashed-at-rest password reset tokens. The plaintext token is
// emailed to the user; only the SHA-256 hash hits Postgres so a database
// leak does not let an attacker reset accounts.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

// Idempotency record for Stripe webhook deliveries. Inserted ONLY after
// the event handler has successfully applied its side effect. A duplicate
// delivery is short-circuited with `{ received: true, duplicate: true }`.
model StripeEvent {
  id              String   @id @default(uuid())
  stripeEventId   String   @unique @map("stripe_event_id")
  type            String
  processedAt     DateTime @default(now()) @map("processed_at")

  @@index([type])
  @@map("stripe_events")
}

// Per-user, per-day AI usage counter. Replaces the previous in-memory
// Map-based counter so that limits survive process restarts and apply
// across multiple API replicas.
//
// `bucket` is a UTC date in YYYY-MM-DD; the (userId, bucket) compound
// uniqueness lets us upsert atomically on each call.
model AiUsage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bucket    String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, bucket])
  @@index([userId])
  @@map("ai_usage")
}

model BibleChapterCache {
  id          String   @id @default(uuid())
  translation String
  book        String
  chapter     Int
  payload     Json
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([translation, book, chapter])
  @@index([translation, book])
  @@map("bible_chapter_cache")
}
